# Copy to deploy/.env. Used by deploy/docker-compose.yml.
JWT_SECRET=            # required, 16+ random characters
POSTGRES_PASSWORD=     # required
PUBLIC_URL=https://forgehubcode.com
WEB_PORT=8080

# ─── Git over SSH on the standard port 22 ─────────────────────────────────────
# 1. On the host: sudo deploy/ssh/install.sh 2222   (prints the key for step 2)
# 2. Fill these in, then: docker compose up -d
FORGEHUB_SSH_PORT=2222                 # ForgeHub listens here (loopback only)
FORGEHUB_SSH_PUBLIC_PORT=22            # what the clone box tells people
FORGEHUB_SSH_FORWARD_KEY=              # "ssh-ed25519 AAAA… forgehub-forward" from install.sh
# FORGEHUB_SSH_HOST=forgehubcode.com   # only if it differs from the web hostname
# FORGEHUB_SSH_BIND=127.0.0.1          # default; never widen it while a forward key is set
