# Git over the standard port 22 for ForgeHub, alongside normal administration.
# Installed as /etc/ssh/sshd_config.d/forgehub.conf by install.sh. Only the `git`
# user is affected; every other account logs in exactly as before.
Match User git
    AuthorizedKeysFile none
    AuthorizedKeysCommand /usr/local/sbin/forgehub-authorized-keys %f %t %k
    AuthorizedKeysCommandUser git
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitUserRC no
