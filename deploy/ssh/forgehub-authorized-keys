#!/bin/sh
# sshd AuthorizedKeysCommand for the `git` user (see sshd_config.forgehub).
#   forgehub-authorized-keys <fingerprint> <key-type> <key-base64>   (sshd: %f %t %k)
# Prints the authorized_keys line for the presented key. A key registered in
# ForgeHub is looked up there; any other key is allowed through as-is, because SSH
# cannot connect without one and unregistered keys may still clone PUBLIC repos
# (ForgeHub treats them as read-only visitors). The line pins the key to
# forgehub-shell with its fingerprint, so any key can do nothing on this host but git.
set -eu
CONF=${FORGEHUB_SSH_CONF:-/etc/forgehub/ssh.conf}
# shellcheck disable=SC1090
. "$CONF"

fp=${1:-}
case $fp in SHA256:*) ;; *) exit 1 ;; esac
[ -z "$(printf %s "$fp" | tr -d 'A-Za-z0-9+/:')" ] || exit 1

ktype=${2:-}
kdata=${3:-}
[ -z "$(printf %s "$ktype" | tr -d 'A-Za-z0-9@.-')" ] || exit 1
[ -z "$(printf %s "$kdata" | tr -d 'A-Za-z0-9+/=')" ] || exit 1

key=$(ssh -T -q -l _keys -p "${FORGEHUB_SSH_LISTEN_PORT:-2222}" \
  -i "${FORGEHUB_FORWARD_KEY:-/etc/forgehub/forward_key}" \
  -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 \
  -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="${FORGEHUB_KNOWN_HOSTS:-/etc/forgehub/known_hosts}" \
  127.0.0.1 "forgehub-authorized-key $fp") || key=""

# Not registered (or ForgeHub unreachable, which forgehub-shell then reports).
[ -n "$key" ] || { [ -n "$ktype" ] && [ -n "$kdata" ] || exit 1; key="$ktype $kdata"; }

printf 'restrict,command="%s %s" %s\n' "${FORGEHUB_SHELL:-/usr/local/sbin/forgehub-shell}" "$fp" "$key"
