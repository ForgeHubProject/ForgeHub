# ForgeHub — PostgreSQL environment.
# Copy to .env.postgres and fill in the required values.
#
#   cp .env.postgres.example .env.postgres
#   docker compose -f docker-compose.postgres.yml --env-file .env.postgres up -d

# ─── Required ─────────────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
JWT_SECRET=

# PostgreSQL password for the `forgehub` database user.
# Used by both the postgres container and forgehub's DATABASE_URL.
# Must be URL-safe — use hex, not base64 (base64 produces +/= which break the URL).
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ─── Web ──────────────────────────────────────────────────────────────────────

# Port nginx publishes on the host. Default: 8080.
WEB_PORT=8080

# ─── Email notifications ──────────────────────────────────────────────────────

# Public origin of this instance (used in notification email links).
# Default when unset: http://localhost:5173
PUBLIC_URL=

# SMTP delivery. When SMTP_URL (or SMTP_HOST) is set, notification emails are
# sent via nodemailer; otherwise a DEV transport appends emails to
# <GIT_STORAGE_ROOT>/mail-outbox.jsonl.
#   SMTP_URL=smtp://user:pass@smtp.example.com:587
# ...or the discrete form:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=
#   SMTP_PASS=
SMTP_URL=

# From: address on outgoing mail. Default: ForgeHub <no-reply@forgehub.local>
MAIL_FROM=

# HMAC secret for one-click unsubscribe tokens. Falls back to JWT_SECRET.
UNSUBSCRIBE_SECRET=

# ─── Actions-style CI ─────────────────────────────────────────────────────────
# Executes repo-author-controlled shell with NO sandbox. OFF by default.
# Set to 1 ONLY on a single-tenant instance where every pusher is trusted.
FORGEHUB_CI=

# Per-job wall-clock timeout in seconds. Default: 600.
CI_JOB_TIMEOUT=

# Max bytes per job log. Default: 10485760 (10 MiB).
CI_MAX_LOG_BYTES=

# ─── SSH git transport ────────────────────────────────────────────────────────
# OFF by default. Set FORGEHUB_SSH_PORT to enable.
# Also uncomment the SSH ports block in docker-compose.postgres.yml.
#
# Recommended dev port: 2222
# Recommended prod port: 22 (forward from load-balancer)
FORGEHUB_SSH_PORT=

# Explicit hostname shown in the web clone box SSH URL.
# When unset the browser's hostname is used.
FORGEHUB_SSH_HOST=

# ─── Profile avatars ──────────────────────────────────────────────────────────
# Max upload size in bytes. Default: 2097152 (2 MiB).
AVATAR_MAX_BYTES=

# ─── Raw blob downloads ───────────────────────────────────────────────────────
# Max bytes served per rawblob request. Default: unlimited.
FORGEHUB_RAWBLOB_MAX_BYTES=
