DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# Client / integration: base URL of this API (e.g. Git remote helper, CLI, Postman collection).
# FORGEHUB_API_URL="http://localhost:3001"

# On-disk root for bare Git repositories created by POST /repos.
GIT_STORAGE_ROOT="./git-storage"

# SSH git transport (issue #116 / #154). OFF unless FORGEHUB_SSH_PORT is set.
# On first start an ed25519 host key is generated at <GIT_STORAGE_ROOT>-ssh/host_key.
# Use port 2222 for dev (no root required). The fingerprint is logged on startup and
# exposed at GET /server/info so users can verify their known_hosts entry.
# Rate-limiting: 5 failed publickey auth attempts per IP per 60 s.
# FORGEHUB_SSH_PORT=2222
# Optional host shown in the web clone box's ssh:// URL (defaults to the browser host).
# FORGEHUB_SSH_HOST="git.example.com"
