# Copy to .env before running `docker compose up` / `podman compose up`.

# Required. Generate with: openssl rand -base64 32
JWT_SECRET=

# Port the web container (nginx, serving the SPA + proxying /auth /repos /git etc.
# to the api container) publishes on the host. Default: 8080.
WEB_PORT=8080

# ─── Email notifications (issue #123) ─────────────────────────────────────────
# Public origin of this instance, used to build links and the one-click
# unsubscribe URL inside notification emails. In the container topology nginx
# serves both the SPA and the proxied API under this one origin.
# Default when unset: http://localhost:5173
PUBLIC_URL=

# SMTP delivery. When SMTP_URL (or SMTP_HOST) is set, notification emails are
# sent via nodemailer; otherwise a DEV transport appends each rendered email as
# a JSON line to <GIT_STORAGE_ROOT>/mail-outbox.jsonl so dev/self-host without
# SMTP still "delivers" somewhere inspectable.
#   SMTP_URL=smtp://user:pass@smtp.example.com:587
# ...or the discrete form:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=
#   SMTP_PASS=
SMTP_URL=

# From: address on outgoing mail. Default: ForgeHub <no-reply@forgehub.local>
MAIL_FROM=

# HMAC secret for signing one-click unsubscribe tokens. Falls back to JWT_SECRET,
# then a fixed dev constant. Set this in production.
UNSUBSCRIBE_SECRET=

# ─── Actions-style CI (issue #86) ─────────────────────────────────────────────
# The built-in CI runner executes repo-author-controlled shell on the host with
# NO sandbox in v0, so it is OFF by default. Set to 1 ONLY on a single-tenant,
# self-hosted instance where every pusher is already trusted with shell access.
FORGEHUB_CI=

# Per-job wall-clock timeout in seconds for CI jobs. Default: 600.
CI_JOB_TIMEOUT=

# ─── SSH git transport (issue #116 / #154) ────────────────────────────────────
# ForgeHub ships a built-in SSH git server (no system sshd required). It is OFF
# by default — set FORGEHUB_SSH_PORT to enable it.
#
# Recommended dev port: 2222  (avoids needing root, doesn't clash with system SSH)
# Recommended prod port: 22   (standard; forward from a container or load balancer)
#
# Quick start:
#   1. Set FORGEHUB_SSH_PORT=2222
#   2. Restart the API — it generates an ed25519 host key on first start under
#      <GIT_STORAGE_ROOT>-ssh/host_key and logs the key fingerprint.
#   3. Users add their public keys at Settings → SSH keys.
#   4. Clone: git clone ssh://git@<host>:2222/<owner>/<repo>.git
#
# The host-key fingerprint is also visible in the API at GET /server/info and
# on the SSH keys settings page, so users can verify their known_hosts entry.
#
# Security: SSH and HTTPS use IDENTICAL access checks and post-receive hooks.
# Rate-limiting (5 failed auth attempts / 60 s per IP) is applied automatically.
FORGEHUB_SSH_PORT=

# Optional: explicit hostname shown in the web clone box SSH URL.
# When unset the browser's hostname is used (correct for most deployments).
FORGEHUB_SSH_HOST=

# ─── Profile avatars (issue #115) ─────────────────────────────────────────────
# Max size (bytes) accepted by POST /users/me/avatar. Over-limit uploads are
# rejected with 413. Avatar bytes are stored on the filesystem under a sibling of
# the git storage root (<GIT_STORAGE_ROOT>-avatars). Default: 2097152 (2 MiB).
AVATAR_MAX_BYTES=

# ─── Raw blob downloads (issue #157) ──────────────────────────────────────────
# GET /repos/:handle/:name/rawblob streams file bytes straight from git, so a
# blob of any size costs the API one relay buffer rather than its own size.
#
# There is NO size limit by default, and that is deliberate: a contributor who
# can push a file can fetch it back. Setting this opts into a policy ceiling
# (over-limit requests get 413 with the real size, decided before any bytes are
# sent — it never interrupts a transfer). Leave it blank for unlimited.
# A value that is not a positive integer — including 0 — is rejected with a log
# line and leaves the route unlimited; it is NOT read as "serve nothing".
FORGEHUB_RAWBLOB_MAX_BYTES=

# This is the only knob the route has. There is deliberately no concurrency
# limit, no queue and no stall/idle timeout in the API: nothing in the API can
# interrupt a download that is making progress, however slow the link and
# however large the file. Concurrency is capped per client at the edge instead
# (`limit_conn` in apps/web/nginx.conf), which is the only layer that can see
# who is asking. See the comments at the top of apps/api/src/rawblob-limits.ts
# for why the API-side versions were removed.
#
# The edge is not equally free of limits: nginx's `send_timeout` is NOT reset by
# partial progress, so it imposes a rate floor of roughly (socket buffering) /
# send_timeout — about 0.4 KiB/s at the 1h that apps/web/nginx.conf ships. Raise
# `send_timeout` there if you need a lower floor. It is a floor, not a size or
# duration limit, and it is not something to compensate for on this side.
